<?xml version="1.0" encoding="utf-8"?>
<!--
  v0.16.0：登录 token / 下载记录 / 译文缓存全部留在本机。
  allowBackup=false 已关闭云备份；此处再显式关闭 Android 12+ 的设备迁移与应用数据提取。
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>