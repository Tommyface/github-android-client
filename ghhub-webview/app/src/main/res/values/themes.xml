<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- GitHub Primer Dark 为基底，保证 WebView 网页端与原生壳视觉零割裂 -->
    <style name="Theme.GHHub" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent_blue</item>
        <item name="colorPrimaryDark">@color/bg_canvas</item>
        <item name="colorAccent">@color/accent_green</item>
        <item name="android:windowBackground">@color/bg_page</item>
        <item name="android:statusBarColor">@color/surface_1</item>
        <item name="android:navigationBarColor">@color/surface_1</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
